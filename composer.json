{
    "name": "imarc/jin-distill",
    "description": "Analyze, normalize, flatten, and diff Dotink/Jin configuration.",
    "type": "library",
    "authors": [
        {
            "name": "Austin Fishbaugh",
            "email": "austinfishbaugh@imarc.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "dotink/jin": "^4.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "JinDistill\\": "src/JinDistill/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JinDistill\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
